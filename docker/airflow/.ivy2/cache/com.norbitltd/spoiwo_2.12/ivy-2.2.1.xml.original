        <developer>
            <id>norbert-radyk</id>
            <name>Norbert Radyk</name>
        </developer>
    </developers>
    <properties>
        <info.versionScheme>early-semver</info.versionScheme>
    </properties>
    <dependencies>
        <dependency>
