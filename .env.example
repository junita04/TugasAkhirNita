# ============================================================
# Postgres Serving (untuk FastAPI lokal + metadata Superset)
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=academic_serving
POSTGRES_USER=academic
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=public

# ============================================================
# Superset
# ============================================================
SUPERSET_DB=superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_SECRET_KEY=change-this-secret-key

# ============================================================
# MinIO (Object Storage Data Lake)
# ============================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin-password
MINIO_BUCKET_WAREHOUSE=warehouse
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_MODELS=models
MINIO_BUCKET_LOGS=logs

# Kredensial yang dipakai Spark/Trino untuk akses S3 (MinIO)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin-password
S3_ENDPOINT=http://minio:9000
S3_PATH_STYLE_ACCESS=true

# ============================================================
# Hive Metastore (metadata tabel Iceberg)
# ============================================================
HIVE_METASTORE_URI=thrift://hive-metastore:9083
POSTGRES_HIVE_HOST=postgres-hive
POSTGRES_HIVE_PORT=5432
POSTGRES_HIVE_DB=metastore
POSTGRES_HIVE_USER=hive
POSTGRES_HIVE_PASSWORD=hive-password

# ============================================================
# Spark
# ============================================================
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI=http://localhost:8080
SPARK_HISTORY_UI=http://localhost:18080

# 'local' = jalankan Spark di mesin lokal (pipeline FastAPI),
# 'cluster' = gunakan Spark Master dari Docker.
SPARK_MODE=local
# Untuk local: local[*]. Untuk cluster: spark://spark-master:7077.
SPARK_MASTER_URL=local[*]

# Warehouse Iceberg:
# - local  : folder filesystem 'iceberg/'
# - cluster: s3a://<MINIO_BUCKET_WAREHOUSE>/iceberg via MinIO
ICEBERG_CATALOG=local
# Untuk local gunakan folder iceberg/. Untuk cluster gunakan s3a://warehouse/iceberg.
ICEBERG_WAREHOUSE=iceberg

# ============================================================
# Trino (SQL Query Engine -> Superset)
# ============================================================
TRINO_URI=http://trino:8082
TRINO_HOST=trino
TRINO_PORT=8082
TRINO_CATALOG=iceberg
TRINO_USER=trino

# ============================================================
# Airflow (Orkestrasi pipeline)
# ============================================================
AIRFLOW_WEBSERVER_PORT=8085
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=admin-local-password
POSTGRES_AIRFLOW_HOST=postgres-airflow
POSTGRES_AIRFLOW_PORT=5432
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow-password
